# SearXNG deployment on Render
# Copy this file and use values in Render dashboard -> Environment

# Required: Your SearXNG instance URL (set in Render dashboard)
# Example: https://searxng.onrender.com
SEARXNG_BASE_URL=https://your-app-name.onrender.com

# Required: Secret key for session encryption (auto-generated by Render)
# If setting manually, generate with: openssl rand -hex 32
SEARXNG_SECRET=changeme
